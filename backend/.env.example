# Copy this file to backend/.env and replace the placeholder values.
DATABASE_URL=postgresql://postgres:password@localhost:5432/ecotime
SECRET_KEY=replace-with-a-long-random-secret
FLASK_ENV=development

# Electricity Maps API key (used by backend only — never expose in frontend)
ELECTRICITY_MAPS_API_KEY=your_api_key_here

# Default grid zone. Must be one of: US-CA, IN, IN-SO, IN-WE, IN-NO, IN-EA, IN-NE,
# US-NY, DK-DK2, GB, FR, DE, BR, AU-NSW (invalid values fall back to US-CA with a warning).
# NOTE: only used when the simulation_config DB row is first created; afterwards
# change the zone from the Settings page (or POST /api/config/simulation).
DEFAULT_ZONE=IN-SO

# Reference baseline intensity (gCO2e/kWh) used for savings. ~650 suits India grids.
BASELINE_INTENSITY=650

# Carbon intensity threshold (gCO2e/kWh) for green window detection
LOW_CARBON_THRESHOLD=180

# Login session length in minutes (default 480 = 8h)
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=480

# Deployed frontend origin(s), comma-separated (localhost is always allowed)
# CORS_ORIGINS=https://your-frontend.vercel.app

# Server port
PORT=5000
