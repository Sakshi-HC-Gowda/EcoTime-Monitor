+"""EcoPoints routes are authenticated, per-user, and awarded by the real schedule flow."""
+from __future__ import annotations
+
+import pytest
+
+from app import create_app
+from extensions import db
+
+
+@pytest.fixture
+def client():
+    app = create_app("testing")
+    with app.app_context():
+        db.drop_all()
+        db.create_all()
+    yield app.test_client()
+    with app.app_context():
+        db.session.remove()
+        db.drop_all()
+
+
+def _register(client, email, org):
+    r = client.post("/api/auth/register", json={
+        "email": email, "password": "Password123!",
+        "first_name": "A", "last_name": "B", "organization_name": org,
+    })
+    body = r.get_json()
+    return {"Authorization": f"Bearer {body['token']}"}, str(body["user"]["id"])
+
+
+def test_ecopoints_routes_require_authentication(client):
+    assert client.get("/api/ecopoints/1/score").status_code == 401
+    assert client.get("/api/badges/1").status_code == 401
+    assert client.post("/api/ecopoints/award", json={}).status_code == 401
+    assert client.get("/api/organizations/1/leaderboard").status_code == 401
+
+
+def test_user_cannot_read_or_award_for_another_user(client):
+    headers_a, id_a = _register(client, "a@example.com", "Org A")
+    _, id_b = _register(client, "b@example.com", "Org B")
+    assert client.get(f"/api/ecopoints/{id_b}/score", headers=headers_a).status_code == 403
+    assert client.get(f"/api/badges/{id_b}", headers=headers_a).status_code == 403
+    r = client.post("/api/ecopoints/award", headers=headers_a, json={
+        "userId": id_b, "eventType": "follow_green_window", "eventId": "x", "activityId": "y"})
+    assert r.status_code == 403
+
+
+def test_scheduling_an_activity_awards_points_once(client):
+    headers, user_id = _register(client, "c@example.com", "Org C")
+    created = client.post("/api/activities", headers=headers, json={
+        "name": "Nightly backup", "type": "flexible", "duration": 30,
+        "priorityScore": 20, "flexibilityScore": 90, "activityType": "batch-processing"})
+    activity_id = created.get_json()["data"]["id"]
+
+    scheduled = client.post(f"/api/activities/{activity_id}/schedule", headers=headers, json={})
+    data = scheduled.get_json()["data"]
+    if not data.get("scheduled"):
+        pytest.skip("No feasible simulated window at this time of day")
+
+    score = client.get(f"/api/ecopoints/{user_id}/score", headers=headers)
+    assert score.status_code == 200
+    assert score.get_json()["totalPoints"] == 10
+    history = client.get(f"/api/ecopoints/{user_id}", headers=headers).get_json()
+    assert history["totalTransactions"] == 1
diff --git a/backend/tests/test_live_forecast_fallback.py b/backend/tests/test_live_forecast_fallback.py
new file mode 100644
index 0000000..78479a2
--- /dev/null
+++ b/backend/tests/test_live_forecast_fallback.py
@@ -0,0 +1,75 @@
+"""Green Windows must use the trained model when a live provider returns no forecast."""
+from __future__ import annotations
+
+from datetime import datetime, timedelta, timezone
+from unittest.mock import patch
+
+import pytest
+
+from app import create_app
+from extensions import db
+
+
+@pytest.fixture
+def client():
+    app = create_app("testing")
+    with app.app_context():
+        db.drop_all()
+        db.create_all()
+    yield app.test_client()
+    with app.app_context():
+        db.session.remove()
+        db.drop_all()
+
+
+def _token(client):
+    r = client.post("/api/auth/register", json={
+        "email": "live@example.com", "password": "Password123!",
+        "first_name": "L", "last_name": "V", "organization_name": "Live Org",
+    })
+    return {"Authorization": f"Bearer {r.get_json()['token']}"}
+
+
+def _live_carbon_without_forecast():
+    now = datetime.now(timezone.utc).replace(minute=0, second=0, microsecond=0)
+    history = [
+        {"datetime": (now - timedelta(hours=24 - i)).isoformat(), "carbonIntensity": 500 + (i % 12) * 10}
+        for i in range(25)
+    ]
+    return {
+        "zone": "IN-SO", "isSimulated": False, "source": "electricity_maps_api",
+        "observedAt": now.isoformat(), "forecastSource": "unavailable",
+        "current": {"datetime": now.isoformat(), "carbonIntensity": 560},
+        "history": history, "forecast": [],
+    }
+
+
+def _ml_forecast():
+    now = datetime.now(timezone.utc).replace(minute=0, second=0, microsecond=0)
+    return [
+        {"datetime": (now + timedelta(hours=i + 1)).isoformat(),
+         "carbonIntensity": 560 - (60 if 4 <= i <= 8 else 0) + i, "isML": True}
+        for i in range(24)
+    ]
+
+
+def test_windows_use_ml_model_when_live_provider_has_no_forecast(client):
+    headers = _token(client)
+    with patch("routes.carbon.get_carbon_data", return_value=_live_carbon_without_forecast()), \
+         patch("forecast.predict.ForecastPredictor.is_trained", return_value=True), \
+         patch("forecast.predict.ForecastPredictor._validate_history", return_value=None), \
+         patch("forecast.predict.ForecastPredictor.predict", return_value=_ml_forecast()):
+        response = client.get("/api/windows?zone=IN-SO", headers=headers)
+    body = response.get_json()
+    assert response.status_code == 200, body
+    assert body["forecastSource"] == "ml_model"
+    assert body["isSimulated"] is False
+    assert body["count"] >= 1
+
+
+def test_windows_still_fail_clearly_without_model_or_forecast(client):
+    headers = _token(client)
+    with patch("routes.carbon.get_carbon_data", return_value=_live_carbon_without_forecast()), \
+         patch("forecast.predict.ForecastPredictor.is_trained", return_value=False):
+        response = client.get("/api/windows?zone=IN-SO", headers=headers)
+    assert response.status_code == 503
